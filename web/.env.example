# Copy to .env.local (never commit real values). One deployment = one client: every client gets its OWN
# Supabase project, its OWN values here, and its own Vercel project. Never reuse another client's keys.

# ---- Database (the client's own Supabase project) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Signs the staff and owner sessions.
STAFF_SESSION_SECRET=
# The public https address of this deployment, e.g. https://acme-rewards.vercel.app (Wallet updates need it)
PUBLIC_BASE_URL=

# ---- Branding (see docs/NEW-CLIENT.md; node scripts/new-client.mjs prints these for you) ----
BRAND_NAME=Demo Venue
BRAND_DEFAULT_VENUE=demo
BRAND_BG=#141210
BRAND_TEXT=#f3e9d2
BRAND_ACCENT=#cda55b
# "Powered by ..." line under the pages. Remove the line to keep "Powered by LOYALTY"; leave it empty to hide it.
# BRAND_POWERED_BY=

# ---- Google Wallet (leave empty until the client's issuer account exists) ----
GOOGLE_WALLET_ISSUER_ID=
# Either the raw service-account JSON, or a path to the JSON file
GOOGLE_WALLET_SA_JSON=
GOOGLE_WALLET_SA_FILE=
# Public https logo shown on Google Wallet cards. Empty = <PUBLIC_BASE_URL>/venues/<slug>/crest.png
LOYALTY_LOGO_URL=

# ---- Apple Wallet (leave empty until the Apple Developer account and Pass Type ID exist) ----
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_CERT_FILE=
APPLE_PASS_KEY=
APPLE_PASS_KEY_FILE=
APPLE_WWDR_CERT=
APPLE_WWDR_CERT_FILE=
# APPLE_POSTER_PASS=1        (iOS 27 poster card; untested on a real phone)

# ---- Development only (never in production) ----
# LOYALTY_FAKE_DB=1          in-memory database so the screens run with no Supabase
# LOYALTY_FAKE_POINTS=
# LOGIN_LOOK_OWNER=a         sign-in design, a or b
# LOGIN_LOOK_STAFF=a

# Owner assistant AI (optional). Off when ASSISTANT_LLM_MODEL is empty; the rule-based reader then answers.
# Local Ollama example:
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_URL=http://127.0.0.1:11434
# ASSISTANT_LLM_KEY=   (only if the endpoint needs a bearer key; never commit it)

# Developer chat with CALABOS (optional). A long random string (40+ characters). Put the SAME value in CALABOS's .env as LOYALTY_BRIDGE_TOKEN.
# Empty = the bridge is off (the endpoints answer 404). It can only read new chat messages and add replies, nothing else.
CALABOS_BRIDGE_TOKEN=
